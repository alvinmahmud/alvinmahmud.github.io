<div class="skill-groups">
  {% for content in entry.contents %}
    <section class="skill-group">
      <h4>{{ content.title }}</h4>
      {% if content.items %}
        <ul>
          {% for item in content.items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endfor %}
</div>
