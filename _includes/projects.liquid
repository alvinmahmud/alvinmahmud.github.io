<div class="col">
  <a
    class="project-link"
    href="{% if project.external_link %}{{ project.external_link }}{% else %}{{ project.url | relative_url }}{% endif %}"
    {% if project.external_link %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
    aria-label="Open {{ project.title }}"
  >
    <div
      class="card h-100 hoverable"
      {% if project.github_repo %}
        data-github-repo="{{ project.github_repo }}"
      {% endif %}
    >
      <div class="card-body">
        <div class="project-card-heading">
          <h2 class="card-title">{{ project.title }}</h2>
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </div>
        <p class="card-text">{{ project.description }}</p>
        {% if project.tech %}
          <ul class="project-tech" aria-label="Technologies">
            {% for item in project.tech %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </a>
</div>
