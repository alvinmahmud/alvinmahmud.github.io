{% assign repo_parts = include.repository | split: '/' %}
{% assign repo_name = repo_parts | last %}
<a
  class="repo"
  href="https://github.com/{{ include.repository }}"
  target="_blank"
  rel="noopener noreferrer"
  data-github-repository="{{ include.repository }}"
>
  <div class="repo-heading">
    <h2 class="repo-name">{{ repo_name }}</h2>
    <div class="repo-counts" aria-label="Repository statistics">
      <span title="Stars"><i class="fa-regular fa-star" aria-hidden="true"></i> <span data-repo-stars>0</span></span>
      <span title="Forks"
        ><i class="fa-solid fa-code-branch" aria-hidden="true"></i> <span data-repo-forks>0</span></span
      >
    </div>
  </div>
  <p class="repo-description">View this repository on GitHub.</p>
  <div class="repo-meta">
    <span class="repo-language" data-repo-language>GitHub</span>
    <time data-repo-updated></time>
  </div>
</a>
