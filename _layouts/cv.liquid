---
layout: default
---
<div class="post resume-page">
  <header class="post-header">
    <h1 class="post-title resume-heading">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="resume-download"
          aria-label="Download resume PDF"
        >
          <i class="fa-solid fa-download" aria-hidden="true"></i>
          <span>Download PDF</span>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        <section class="card mt-3 p-3" aria-labelledby="resume-{{ entry.title | slugify }}">
          <h2 class="card-title font-weight-medium" id="resume-{{ entry.title | slugify }}">{{ entry.title }}</h2>
          <div>
            {% if entry.type == 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include cv/time_table.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </section>
      {% endfor %}
    </div>
  </article>
</div>
